# Yachay Legal AI Backend Environment
PROJECT_NAME="Yachay Legal AI"
VERSION="0.1.0"
API_V1_STR="/api"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (Default local SQLite for quick start; change to postgresql+psycopg://user:pass@localhost:5432/yachay_db for pgvector)
DATABASE_URL="sqlite:///./yachay_legal.db"

# Language and Dialect Configuration
DEFAULT_QUECHUA_DIALECT="quechua_chanka"  # Options: quechua_chanka, quechua_cusco_collao

# AI & Model APIs (Optional external providers, defaults to rule-based & local embedding simulation if not provided)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="local_gemini"

# Official Legal Contacts
DEFENSA_PUBLICA_FONO="1884"
LINEA_100="100"
DEFENSORIA_PUEBLO="0800-15-170"
